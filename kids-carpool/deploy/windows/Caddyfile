# 같이타요 — Caddy 설정
#
# carpool.example.com 을 실제 도메인으로 바꾼 뒤 사용한다.
# Caddy는 80/443 만 사용하며, 이 도메인에 대해 Let's Encrypt 인증서를
# 자동으로 발급/갱신한다(80번 포트로 HTTP-01 검증을 하므로 80도 반드시 열어둘 것).
#
# 정적 프론트(C:\gachitayo\www\index.html 등)를 서빙하고,
# /api/* 와 /ws 는 127.0.0.1:3000 의 Node API로 리버스 프록시한다.
# WebSocket(101 업그레이드)은 reverse_proxy가 자동으로 처리하므로 별도 설정이 필요 없다.

carpool.example.com {
	root * C:\gachitayo\www
	encode gzip

	log {
		output file C:\gachitayo\svc\logs\caddy-access.log {
			roll_size 20mb
			roll_keep 10
		}
		# /ws?token=<JWT> 가 로그에 평문으로 남지 않도록 쿼리스트링의 token 값을 마스킹한다.
		# (참고: https://caddyserver.com/docs/caddyfile/directives/log#filter)
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}

	# 기본 보안 헤더
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}

	# API, WebSocket → 로컬 Node 서버로 프록시 (127.0.0.1에만 바인딩되어 있음)
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /ws {
		reverse_proxy 127.0.0.1:3000
	}

	# 그 외 요청은 정적 파일을 서빙하고, 없으면 SPA용 index.html로 폴백한다.
	handle {
		try_files {path} /index.html
		file_server
	}
}
