<!--
  같이타요 API — WinSW(v2.x) 서비스 설정
  이 파일은 C:\gachitayo\svc\gachitayo-api.xml 로 배치되고,
  같은 폴더의 gachitayo-api.exe(=WinSW 실행파일 복사본)와 짝을 이룬다.
  install-services.ps1 이 이 짝짓기와 install/start를 대신 해준다.
-->
<service>
  <id>gachitayo-api</id>
  <name>Gachitayo API</name>
  <description>같이타요 카풀 앱 Node.js API 서버 (127.0.0.1:3000)</description>

  <!--
    node.exe 절대 경로. PowerShell에서 `where.exe node` 로 실제 경로를 확인하고
    기본값과 다르면 이 값을 수정한 뒤 서비스를 재설치하라(install-services.ps1 재실행).
  -->
  <executable>%ProgramFiles%\nodejs\node.exe</executable>
  <arguments>src\index.js</arguments>

  <!-- server\.env 를 dotenv가 여기서 읽는다 (process.cwd() 기준) -->
  <workingdirectory>C:\gachitayo\repo\server</workingdirectory>

  <logpath>C:\gachitayo\svc\logs</logpath>
  <logmode>roll-by-size</logmode>
  <sizeThreshold>10240</sizeThreshold>
  <keepFiles>8</keepFiles>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>

  <startmode>Automatic</startmode>
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>
