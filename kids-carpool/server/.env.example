# PostgreSQL 접속 정보 (윈도우 설치 시 정한 비밀번호로 교체)
DATABASE_URL=postgres://gachitayo:CHANGE_ME@127.0.0.1:5432/gachitayo

# JWT 서명 키 — 반드시 긴 무작위 문자열로 교체 (예: PowerShell에서
#   -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_}) )
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING

# API 포트 (Caddy가 이 포트로 프록시한다. 방화벽에서 열지 말 것)
PORT=3000

# 최초 시드 시 만들 카풀 그룹
GROUP_NAME=한빛초 카풀
GROUP_SCHOOL=한빛초등학교
INVITE_CODE=HANBIT-2026

# 선택사항: 정적 파일 서빙 (개발/테스트용, 운영은 Caddy 사용)
# STATIC_DIR=C:\gachitayo\www
